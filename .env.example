APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Your local timezone — decides when "today" rolls over and which greeting shows.
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=lorie_app
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google sign-in (optional). Create an OAuth client at
# https://console.cloud.google.com/apis/credentials and add
# <APP_URL>/auth/google/callback as an authorized redirect URI.
# Leave the ID empty to hide the "Continue with Google" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Primary AI provider that decomposes & verifies foods: "gemini" or "groq".
AI_PROVIDER=gemini
# Provider used automatically when the primary is rate-limited (empty = disabled).
AI_FALLBACK_PROVIDER=groq
# Minutes to keep using the fallback after the primary hits its quota.
AI_FALLBACK_COOLDOWN_MINUTES=30

# Google Gemini (primary) — get a free key at https://aistudio.google.com/app/apikey
# Gemini Flash is multimodal, so the same model handles photo capture.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Groq (fallback, free tier, no credit card) — get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Vision model for photo capture (must be multimodal)
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# USDA FoodData Central (free) — get a key at https://fdc.nal.usda.gov/api-key-signup
# Defaults to DEMO_KEY (low rate limits) if left blank.
USDA_API_KEY=
